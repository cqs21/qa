{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asterinas CI to QA contract v1.0 (design)",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/api_declarations"
    },
    {
      "$ref": "#/$defs/snapshot"
    }
  ],
  "$defs": {
    "producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "config_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "test_id",
        "config_id"
      ],
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "arch": {
          "enum": [
            "x86_64",
            "aarch64",
            "riscv64",
            "loongarch64"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "anyOf": [
            {
              "enum": [
                "debug",
                "release",
                "release-lto",
                "none"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "smp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mem_mib": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "filesystem": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "boot_method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "boot_protocol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "arch",
        "platform",
        "profile",
        "smp",
        "mem_mib",
        "filesystem",
        "boot_method",
        "boot_protocol",
        "parameters",
        "unresolved_fields"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "workflow_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.yml$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "enum": [
            "push",
            "pull_request",
            "schedule",
            "workflow_dispatch"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "repository",
        "workflow_path",
        "run_id",
        "attempt",
        "event",
        "ref",
        "source_sha",
        "tested_sha",
        "workflow_sha",
        "base_sha",
        "created_at"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "required": [
        "sha",
        "path",
        "locator",
        "url"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "log",
            "native_report",
            "artifact",
            "method"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "available",
            "expired",
            "unknown"
          ]
        }
      },
      "required": [
        "kind",
        "url",
        "digest",
        "expires_at",
        "availability"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "check_kind": {
          "enum": [
            "runtime",
            "build",
            "lint",
            "performance"
          ]
        },
        "workflow_path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.yml$"
        },
        "primary_event": {
          "anyOf": [
            {
              "enum": [
                "push",
                "schedule",
                "workflow_dispatch"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cadence": {
          "enum": [
            "daily",
            "on_change",
            "manual"
          ]
        },
        "metric_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "test_id",
        "config_id",
        "suite",
        "label",
        "check_kind",
        "workflow_path",
        "primary_event",
        "config",
        "config_digest",
        "cadence",
        "metric_ids",
        "sources"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "catalog"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "boolean"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "arch": {
                "enum": [
                  "x86_64",
                  "aarch64",
                  "riscv64",
                  "loongarch64"
                ]
              },
              "platform": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "configured",
                  "build_only",
                  "not_configured",
                  "unknown"
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "required": [
              "arch",
              "platform",
              "scope",
              "notes"
            ],
            "additionalProperties": false
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "record_id",
        "example",
        "producer",
        "source_sha",
        "completeness",
        "gaps",
        "platforms",
        "entries"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "provisional",
            "accepted"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    },
    "plan_entry": {
      "type": "object",
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "enum": [
            "selected",
            "not_selected",
            "unknown"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "execution_policy": {
          "enum": [
            "run",
            "carry_forward",
            "none"
          ]
        },
        "carried_report_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "test_id",
        "config_id",
        "selection",
        "reason_code",
        "reason",
        "execution_policy",
        "carried_report_id",
        "depends_on",
        "required"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "plan"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "boolean"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "verification_policy": {
          "$ref": "#/$defs/policy"
        },
        "selector": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "rules_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "changed_files_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "ok",
                "fallback",
                "error"
              ]
            },
            "fallback_full": {
              "type": "boolean"
            }
          },
          "required": [
            "version",
            "rules_digest",
            "changed_files_digest",
            "status",
            "fallback_full"
          ],
          "additionalProperties": false
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plan_entry"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "record_id",
        "example",
        "producer",
        "catalog_id",
        "execution",
        "verification_policy",
        "selector",
        "entries"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "container_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "container_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_arch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "runner_class": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "microcode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "host_kernel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "qemu_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rust_toolchain": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "nix_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "flake_lock_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "linux_kernel_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "linux_kernel_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unresolved_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "container_ref",
        "container_digest",
        "host_arch",
        "runner_class",
        "cpu_model",
        "microcode",
        "host_kernel",
        "qemu_version",
        "rust_toolchain",
        "nix_version",
        "flake_lock_digest",
        "linux_kernel_version",
        "linux_kernel_digest",
        "details",
        "unresolved_fields"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "producer_execution": {
          "$ref": "#/$defs/execution"
        },
        "producer_job_id": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "source_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "tested_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "name",
              "digest",
              "source_sha",
              "tested_sha"
            ],
            "additionalProperties": false
          }
        },
        "input_manifest": {
          "type": "object",
          "properties": {
            "tested_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "dependency_digests": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "tested_sha",
            "parameters",
            "dependency_digests"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "input_digest",
        "producer_execution",
        "producer_job_id",
        "artifacts",
        "input_manifest"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "enum": [
            "linux",
            "asterinas"
          ]
        },
        "state": {
          "enum": [
            "measured",
            "missing",
            "error"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "raw_unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_conversion": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "higher",
            "lower"
          ]
        },
        "collected_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison_group": {
          "type": "string",
          "minLength": 1
        },
        "method_version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric_id",
        "system",
        "state",
        "value",
        "unit",
        "raw_unit",
        "unit_conversion",
        "direction",
        "collected_at",
        "comparison_group",
        "method_version",
        "source",
        "reason"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "comparable",
            "incomparable",
            "unknown"
          ]
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "rule_version",
        "reasons"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "kind": {
          "const": "report"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "boolean"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "config_id": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "$ref": "#/$defs/config"
        },
        "config_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/build"
            },
            {
              "type": "null"
            }
          ]
        },
